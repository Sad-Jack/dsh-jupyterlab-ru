{
  "name": "dsh-jupyterlab",
  "version": "0.1.0-local.1.ru.3",
  "description": "Блокноты Python и управление ядрами Jupyter внутри Harness.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sad-Jack/dsh-jupyterlab-ru.git"
  },
  "homepage": "https://github.com/Sad-Jack/dsh-jupyterlab-ru#readme",
  "bugs": {
    "url": "https://github.com/Sad-Jack/dsh-jupyterlab-ru/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "jupyter",
    "jupyterlab",
    "notebook",
    "ipynb",
    "ipykernel",
    "agent",
    "data-analysis",
    "split-view"
  ],
  "files": [
    "lib",
    "python",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "locale",
    "README*.md",
    "UPSTREAM.md",
    "LOCALIZATION.md",
    "LICENSE*",
    "publication.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.1 || ^0.2.1-rc.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
